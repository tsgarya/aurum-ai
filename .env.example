# Optional. The app runs without this key; AI review endpoint reports not_configured.
NEBIUS_API_KEY=
# Token Factory OpenAI-compatible API base URL. Confirm current URL in your Nebius console/docs.
NEBIUS_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1/
# Select a model available to your account; this is a documented example model ID.
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b
# Default market data provider: yfinance. Internet access required for live historical prices.
AURUM_DATA_MODE=auto
# Paper account initial balance (currency-neutral for MVP; avoid mixing markets in one account).
AURUM_INITIAL_CASH=1000000
